---
import { getImage } from 'astro:assets';
import posterWide from '../assets/hero/poster-16x9.jpg';
import posterTall from '../assets/hero/poster-9x16.jpg';
import { site, whatsappLink } from '../data/site';

// Must match the CSS below: phones held upright get the 9:16 reel.
const PORTRAIT = '(max-width: 599px) and (orientation: portrait)';
const AV1 = 'video/webm; codecs="av01.0.05M.08"';

const wide = await getImage({ src: posterWide, widths: [640, 960, 1276], format: 'webp' });
const tall = await getImage({ src: posterTall, widths: [400, 720], format: 'webp' });
const wideJpg = await getImage({ src: posterWide, width: 1276, format: 'jpg', quality: 80 });
---

<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title" class="voice hero-title">
    <span class="rise">Create. Capture.</span>
    <span class="voice-2 rise rise--2">Elevate.</span>
  </h1>

  <div class="hero-meta rise rise--3">
    <p class="hero-desc">{site.description}</p>
    <dl class="facts">
      <div>
        <dt class="meta-key">Services</dt>
        <dd>Video, photography, content, social media, branding and marketing</dd>
      </div>
      <div>
        <dt class="meta-key">Enquiries</dt>
        <dd>
          <a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>{' or '}<a href={site.instagram.url} target="_blank" rel="noopener">Instagram</a>
        </dd>
      </div>
    </dl>
    <a class="text-link scroll-link" href="#work">See selected work</a>
  </div>

  <div class="reel frame rise rise--3" data-reel>
    <picture>
      <source media={PORTRAIT} srcset={tall.srcSet.attribute} sizes="100vw" type="image/webp" />
      <source srcset={wide.srcSet.attribute} sizes="(min-width: 90em) 1440px, 100vw" type="image/webp" />
      <img
        src={wideJpg.src}
        width="1276"
        height="718"
        alt="A still from Velune's showreel: portraits of models in bridal and occasion looks."
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>
    <video muted loop playsinline preload="none" aria-label="Velune showreel" data-reel-video></video>
    <!-- Attached only when playback starts, so reduced-motion, Save-Data and
         no-JS visitors download no video at all (preload="none" alone still
         let Chrome fetch ~1 MB in testing). -->
    <template data-reel-sources>
      <source media={PORTRAIT} src="/media/hero/showreel-9x16.webm" type={AV1} />
      <source media={PORTRAIT} src="/media/hero/showreel-9x16.mp4" type="video/mp4" />
      <source src="/media/hero/showreel-16x9.webm" type={AV1} />
      <source src="/media/hero/showreel-16x9.mp4" type="video/mp4" />
    </template>
    <div class="reel-controls" data-reel-controls hidden>
      <button class="reel-toggle" type="button" data-reel-sound aria-label="Turn sound on">
        <svg class="icon-muted" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6h2.5L8 3v10L4.5 10H2z" /><path class="stroke" d="M10.5 6l4 4M14.5 6l-4 4" /></svg>
        <svg class="icon-sound" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6h2.5L8 3v10L4.5 10H2z" /><path class="stroke" d="M10.5 5.5a3.5 3.5 0 0 1 0 5M12.5 3.5a6.3 6.3 0 0 1 0 9" /></svg>
        <span class="reel-toggle-label" aria-hidden="true">Unmute</span>
      </button>
      <button class="reel-toggle" type="button" data-reel-toggle aria-label="Play showreel">
        <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" /><rect x="9.5" y="2.5" width="3" height="11" /></svg>
        <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" /></svg>
        <span class="reel-toggle-label" aria-hidden="true">Play</span>
      </button>
    </div>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLElement>('[data-reel]');
  const video = frame?.querySelector<HTMLVideoElement>('[data-reel-video]');
  const toggle = frame?.querySelector<HTMLButtonElement>('[data-reel-toggle]');
  const sound = frame?.querySelector<HTMLButtonElement>('[data-reel-sound]');

  if (frame && video && toggle && sound) {
    const label = toggle.querySelector('.reel-toggle-label')!;
    const soundLabel = sound.querySelector('.reel-toggle-label')!;
    const portrait = window.matchMedia('(max-width: 599px) and (orientation: portrait)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let wantsPlay = !reduceMotion && !saveData;
    let visible = true;

    // The control reflects what the visitor asked for, not the momentary
    // element state, so it reads "Pause" while a requested play is loading.
    const render = () => {
      frame.classList.toggle('is-paused', !wantsPlay);
      label.textContent = wantsPlay ? 'Pause' : 'Play';
      toggle.setAttribute('aria-label', wantsPlay ? 'Pause showreel' : 'Play showreel');
      frame.classList.toggle('is-unmuted', !video.muted);
      soundLabel.textContent = video.muted ? 'Unmute' : 'Mute';
      sound.setAttribute('aria-label', video.muted ? 'Turn sound on' : 'Turn sound off');
    };

    const sources = frame.querySelector<HTMLTemplateElement>('[data-reel-sources]')!;
    const play = () => {
      if (!video.querySelector('source')) {
        video.append(sources.content.cloneNode(true));
        video.load();
      }
      // Rejected in e.g. iOS Low Power Mode: the still frame simply stays.
      video.play().catch(() => {
        wantsPlay = false;
        render();
      });
    };

    video.addEventListener('playing', () => frame.classList.add('is-live'));
    video.addEventListener('play', render);
    video.addEventListener('pause', render);
    video.addEventListener('error', () => frame.classList.remove('is-live'), true);

    frame.querySelector<HTMLElement>('[data-reel-controls]')!.hidden = false;

    // The reel always starts muted; sound only ever comes on from this click.
    // Turning sound on also starts playback if the reel was paused.
    sound.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && !wantsPlay) {
        wantsPlay = true;
        play();
      }
      render();
    });
    video.addEventListener('volumechange', render);

    toggle.addEventListener('click', () => {
      wantsPlay = !wantsPlay;
      render();
      if (wantsPlay) play();
      else video.pause();
    });

    // Sources are chosen once by the browser; re-run selection only when the
    // phone-portrait boundary is crossed, so only the matching file is fetched.
    portrait.addEventListener('change', () => {
      if (!video.querySelector('source')) return; // nothing loaded yet
      frame.classList.remove('is-live');
      video.load();
      if (wantsPlay && visible) play();
    });

    // Don't keep decoding while the reel is off-screen.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible && !video.paused) video.pause();
      else if (visible && wantsPlay && video.paused) play();
    }, { threshold: 0.15 }).observe(frame);

    render();
  }
</script>

<style>
  .hero { padding-top: clamp(2.5rem, 1rem + 6vw, 7.5rem); padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }

  .hero-title { font-size: var(--t-hero); line-height: 0.92; letter-spacing: -0.045em; }
  .hero-title .voice-2 { line-height: 1; }

  .hero-meta {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--stone);
  }
  .hero-desc { max-width: 38ch; color: var(--graphite); }
  .facts { display: grid; gap: 1.25rem; }
  .facts dd { margin: 0.2rem 0 0; font-size: var(--t-small); }
  .facts a { text-underline-offset: 0.25em; }
  .scroll-link { justify-self: start; align-self: start; display: inline-flex; min-height: 2.75rem; align-items: center; }
  @media (min-width: 60em) {
    .hero-meta { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem; }
    .hero-desc { grid-column: 1 / span 4; }
    .facts { grid-column: 5 / span 6; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .scroll-link { grid-column: 11 / -1; justify-self: end; white-space: nowrap; }
  }
  @media (max-width: 59.99em) { .facts { grid-template-columns: 1fr 1fr; max-width: 36rem; } }

  .reel {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    aspect-ratio: 16 / 9;
    background: var(--charcoal);
  }
  @media (max-width: 599px) and (orientation: portrait) {
    .reel { aspect-ratio: 9 / 16; max-height: 82svh; margin-inline: auto; }
  }
  .reel picture, .reel video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .reel img, .reel video { object-fit: cover; }
  .reel video { opacity: 0; transition: opacity 600ms var(--ease); }
  .reel.is-live video { opacity: 1; }

  .reel-controls {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.25rem);
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    display: flex;
    gap: 0.5rem;
  }
  .reel-controls[hidden] { display: none; }
  .reel-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem 0.5rem 0.85rem;
    border: 1px solid rgb(245 240 232 / 0.35);
    border-radius: 999px;
    background: rgb(20 20 20 / 0.72);
    color: var(--ivory);
    font-size: var(--t-small);
    font-weight: 700;
    backdrop-filter: blur(6px);
  }
  .reel-toggle:hover { background: var(--charcoal); }
  .reel-toggle svg { width: 16px; height: 16px; fill: currentColor; }
  .reel-toggle svg .stroke { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; }
  .reel .icon-play, .reel .icon-sound { display: none; }
  .reel.is-paused .icon-play, .reel.is-unmuted .icon-sound { display: block; }
  .reel.is-paused .icon-pause, .reel.is-unmuted .icon-muted { display: none; }
  /* Narrow phones: icon-only controls (each keeps its accessible label) */
  @media (max-width: 30em) {
    .reel-toggle { padding: 0.5rem; min-width: 2.75rem; justify-content: center; }
    .reel-toggle-label { display: none; }
  }
</style>
