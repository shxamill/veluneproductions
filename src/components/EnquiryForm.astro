---
import { allServices } from '../data/services';
import { site, whatsappLink } from '../data/site';

interface Props {
  idPrefix: string;
  tone?: 'light' | 'dark';
}
const { idPrefix: p, tone = 'light' } = Astro.props;
const timelines = ['Not sure yet', 'As soon as possible', 'Within a month', 'In 1–3 months', 'Later than 3 months'];
---

<!--
  Delivery: WhatsApp only (confirmed by Velune). With JS, the form validates,
  composes a message and opens wa.me — the visitor sends it themselves, so the
  page never claims a message was "sent". Without JS, the native GET submit
  opens wa.me with the project description as ?text=.
-->
<form
  class:list={['enquiry', `enquiry--${tone}`]}
  data-enquiry
  data-number={site.whatsapp.number}
  action={`https://wa.me/${site.whatsapp.number}`}
  method="get"
  target="_blank"
  novalidate
  aria-labelledby={`${p}-form-title`}
>
  <h3 id={`${p}-form-title`} class="form-title">Project enquiry</h3>
  <p class="form-note">Fields are required unless marked optional.</p>

  <div class="error-summary" data-summary role="alert" tabindex="-1" hidden>
    <p>Check these fields:</p>
    <ul></ul>
  </div>

  <div class="fields">
    <div class="field">
      <label for={`${p}-name`}>Your name</label>
      <input id={`${p}-name`} data-field="name" type="text" autocomplete="name" required aria-describedby={`${p}-name-error`} />
      <p class="error" id={`${p}-name-error`} hidden></p>
    </div>

    <div class="field">
      <label for={`${p}-contact`}>WhatsApp number or email</label>
      <input id={`${p}-contact`} data-field="contact" type="text" required aria-describedby={`${p}-contact-hint ${p}-contact-error`} />
      <p class="hint" id={`${p}-contact-hint`}>Where Velune should reply.</p>
      <p class="error" id={`${p}-contact-error`} hidden></p>
    </div>

    <fieldset class="field field--wide services">
      <legend>Services you're interested in <span class="optional">(optional)</span></legend>
      <div class="options">
        {allServices.map((s) => (
          <label class="option">
            <input type="checkbox" data-service value={s.name} data-slug={s.slug} />
            <span>{s.name}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="field field--wide">
      <label for={`${p}-text`}>About the project</label>
      <textarea id={`${p}-text`} name="text" data-field="message" rows="5" required aria-describedby={`${p}-text-hint ${p}-text-error`}></textarea>
      <p class="hint" id={`${p}-text-hint`}>What you're making, where it will be used, and anything you already have.</p>
      <p class="error" id={`${p}-text-error`} hidden></p>
    </div>

    <div class="field">
      <label for={`${p}-timeline`}>Timeline <span class="optional">(optional)</span></label>
      <select id={`${p}-timeline`} data-field="timeline">
        <option value="">Choose a timeline</option>
        {timelines.map((t) => <option>{t}</option>)}
      </select>
    </div>
  </div>

  <div class="actions">
    <button class:list={['btn', tone === 'dark' ? 'btn--light' : 'btn--dark']} type="submit">Continue in WhatsApp</button>
    <p class="hint">Opens WhatsApp with your message ready. You press send.</p>
  </div>

  <div class="status" data-status role="status" aria-live="polite"></div>
  <div class="fallback" data-fallback hidden>
    <a class="text-link" data-open href={whatsappLink()} target="_blank" rel="noopener">Open WhatsApp again</a>
    <button class="text-link copy" type="button" data-copy>Copy message</button>
  </div>
</form>

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const looksLikeEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  const looksLikePhone = (v: string) => /^[+()\d\s-]+$/.test(v) && v.replace(/\D/g, '').length >= 7;

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-enquiry]')) {
    const number = form.dataset.number!;
    const get = (name: string) => form.querySelector<Field>(`[data-field="${name}"]`)!;
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const fallback = form.querySelector<HTMLElement>('[data-fallback]')!;
    let lastMessage = '';

    // Pre-select a service passed as ?service=<slug> (from "Ask about…" links).
    const wanted = new URLSearchParams(location.search).get('service');
    if (wanted) {
      const box = form.querySelector<HTMLInputElement>(`[data-slug="${CSS.escape(wanted)}"]`);
      if (box) box.checked = true;
    }

    const setError = (field: Field, message: string) => {
      const error = document.getElementById(`${field.id}-error`)!;
      error.textContent = message;
      error.hidden = !message;
      field.toggleAttribute('aria-invalid', Boolean(message));
    };

    const validate = () => {
      const problems: { field: Field; message: string }[] = [];
      const name = get('name');
      const contact = get('contact');
      const message = get('message');
      const c = contact.value.trim();

      if (!name.value.trim()) problems.push({ field: name, message: 'Enter your name.' });
      if (!c) problems.push({ field: contact, message: 'Enter a WhatsApp number or an email address so Velune can reply.' });
      else if (!looksLikeEmail(c) && !looksLikePhone(c))
        problems.push({ field: contact, message: 'Enter a phone number with at least 7 digits, or an email address like name@example.com.' });
      if (message.value.trim().length < 10)
        problems.push({ field: message, message: 'Describe the project in a sentence or two (at least 10 characters).' });

      for (const f of [name, contact, message]) setError(f, problems.find((x) => x.field === f)?.message ?? '');
      return problems;
    };

    const compose = () => {
      const services = [...form.querySelectorAll<HTMLInputElement>('[data-service]:checked')].map((b) => b.value);
      const timeline = get('timeline').value;
      return [
        "Hi Velune, I'd like to talk about a project.",
        '',
        `Name: ${get('name').value.trim()}`,
        `Reply to: ${get('contact').value.trim()}`,
        services.length ? `Services: ${services.join(', ')}` : '',
        timeline ? `Timeline: ${timeline}` : '',
        '',
        'Project:',
        get('message').value.trim(),
      ]
        .filter((line, i, all) => line !== '' || all[i - 1] !== '')
        .join('\n');
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.textContent = '';
      fallback.hidden = true;

      const problems = validate();
      const list = summary.querySelector('ul')!;
      list.replaceChildren(
        ...problems.map(({ field, message }) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${field.id}`;
          a.textContent = message;
          a.addEventListener('click', (e) => { e.preventDefault(); field.focus(); });
          li.append(a);
          return li;
        }),
      );
      summary.hidden = problems.length === 0;
      if (problems.length) {
        summary.focus();
        return;
      }

      lastMessage = compose();
      const url = `https://wa.me/${number}?text=${encodeURIComponent(lastMessage)}`;
      form.querySelector<HTMLAnchorElement>('[data-open]')!.href = url;
      // Not using the 'noopener' feature: with it, window.open always returns
      // null, so a blocked pop-up couldn't be told apart from a successful one.
      const opened = window.open(url, '_blank');
      if (opened) opened.opener = null;
      status.textContent = opened === null
        ? "WhatsApp didn't open automatically. Use the link below, or copy the message and send it to " + '+' + number + '.'
        : 'WhatsApp opened in a new tab with your message. Press send there to reach Velune.';
      fallback.hidden = false;
    });

    form.querySelector('[data-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastMessage || compose());
        status.textContent = 'Message copied. Paste it into WhatsApp or Instagram to send it to Velune.';
      } catch {
        status.textContent = "Couldn't copy automatically. Select the project text above and copy it manually.";
      }
    });

    // Clear a field's error once it's corrected.
    for (const name of ['name', 'contact', 'message']) {
      const field = get(name);
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') !== null) validate();
      });
    }
  }
</script>

<style>
  .enquiry { display: grid; gap: 1.5rem; }
  .enquiry--dark {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid #2e2c29;
    border-radius: 14px;
    background: #1a1a19;
  }
  .form-title { font-size: 1.25rem; font-weight: 700; }
  .form-note, .hint { font-size: var(--t-small); color: var(--graphite); }
  .enquiry--dark :is(.form-note, .hint, .optional) { color: var(--stone); }
  .optional { font-weight: 400; color: var(--graphite); }

  .fields { display: grid; gap: 1.5rem 2rem; }
  @media (min-width: 40em) {
    .fields { grid-template-columns: 1fr 1fr; }
    .field--wide { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: 0.4rem; align-content: start; min-width: 0; border: 0; padding: 0; }
  .field > label, legend { font-weight: 700; font-size: var(--t-small); }
  legend { padding: 0; margin-bottom: 0.75rem; }

  /* Underline fields, as in the reference */
  input[type='text'], textarea, select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0;
    border: 0;
    border-bottom: 1px solid var(--graphite);
    border-radius: 0;
    background: transparent;
    font-size: 1.0625rem;
  }
  textarea { resize: vertical; min-height: 7rem; line-height: 1.5; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%); background-position: calc(100% - 10px) 55%, calc(100% - 5px) 55%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 1.5rem; }
  .enquiry--dark :is(input[type='text'], textarea, select) { border-bottom-color: var(--stone); }
  .enquiry--dark select option { color: var(--charcoal); }
  :is(input[type='text'], textarea, select):focus-visible { outline: none; border-bottom: 2px solid currentColor; margin-bottom: -1px; }
  [aria-invalid] { border-bottom-color: #9b2c1f !important; }
  .enquiry--dark [aria-invalid] { border-bottom-color: #f2a395 !important; }

  .options { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .option { position: relative; display: inline-flex; }
  .option input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .option span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--graphite);
    border-radius: 999px;
    font-size: var(--t-small);
  }
  .enquiry--dark .option span { border-color: color-mix(in srgb, var(--stone) 55%, var(--graphite)); }
  .option input:checked + span { background: var(--charcoal); color: var(--ivory); border-color: var(--charcoal); }
  .enquiry--dark .option input:checked + span { background: var(--ivory); color: var(--charcoal); border-color: var(--ivory); }
  .option input:focus-visible + span { outline: 2px solid currentColor; outline-offset: 3px; }

  .error { font-size: var(--t-small); font-weight: 700; color: #9b2c1f; }
  .enquiry--dark .error { color: #f2a395; }
  .error-summary {
    padding: 1rem 1.25rem;
    border-left: 3px solid #9b2c1f;
    background: color-mix(in srgb, #9b2c1f 7%, transparent);
  }
  .enquiry--dark .error-summary { border-left-color: #f2a395; background: rgb(242 163 149 / 0.08); }
  .error-summary p { font-weight: 700; }
  .error-summary ul { margin-top: 0.4rem; padding-left: 1.1rem; }
  .error-summary a { display: inline-block; padding-block: 0.2rem; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .actions .btn { min-width: 14rem; }
  .status:empty { display: none; }
  .status { font-weight: 700; }
  .fallback { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .fallback[hidden] { display: none; }
  .copy { background: none; border: 0; padding: 0; min-height: 2.75rem; }
  .fallback a { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
