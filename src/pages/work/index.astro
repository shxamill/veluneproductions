---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import WorkCollage from '../../components/WorkCollage.astro';
import { projects } from '../../data/work';

// Every photograph and reel, client by client.
const photos = projects.flatMap((p) => p.media).filter((m) => m.kind === 'photo').length;
const videos = projects.flatMap((p) => p.media).length - photos;
---

<Base
  title="Selected work"
  description="Every photograph and video in Velune's selected work, made for makeup artists, a luxury clothing label, a stylist and a kids' culture brand."
>
  <PageHead
    line1="Selected work"
    line2="for people and brands."
    intro={`${photos} photographs and ${videos} videos made with makeup artists, a clothing label, a stylist and a kids' culture brand. Reels play without sound; open a client for the full-size set with sound.`}
  />

  <div class="wrap work-list">
    {projects.map((p, i) => <WorkCollage project={p} index={i} eager={i === 0} />)}
  </div>
</Base>

<style>
  /* Grid gap rather than sibling margins: Astro puts the collage script between the first two articles */
  .work-list { display: grid; row-gap: clamp(5rem, 3rem + 7vw, 10rem); padding-bottom: var(--section); }
</style>
