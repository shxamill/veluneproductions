---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { serviceGroups } from '../data/services';
---

<Base
  title="Services"
  description="Video production, photography, iPhone videography, content creation, social media handling and marketing, branding, digital marketing and Meta Ads, from Velune Creative Studio."
>
  <PageHead
    line1="Nine services,"
    line2="booked alone or together."
    intro="Velune brings production, content, social, branding and marketing under one studio. Each service below can be booked on its own, or combined around a single brief."
  />

  <div class="wrap services-layout">
    <nav class="index" aria-label="Services on this page">
      {serviceGroups.map((g) => (
        <div class="index-group">
          <p class="meta-key">{g.name}</p>
          <ul role="list">
            {g.services.map((s) => <li><a href={`#${s.slug}`}>{s.name}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>

    <div class="groups">
      {serviceGroups.map((g) => (
        <section class="group" aria-labelledby={`group-${g.slug}`}>
          <h2 id={`group-${g.slug}`} class="group-name">{g.name}</h2>
          {g.services.map((s) => (
            <article class="service" id={s.slug} aria-labelledby={`${s.slug}-title`}>
              <h3 id={`${s.slug}-title`} class="service-name">{s.name}</h3>
              <p class="service-summary">{s.summary}</p>
              <p class="service-detail">{s.detail}</p>
              {s.steps && (
                <ol class="steps" role="list">
                  {s.steps.map((step, i) => (
                    <li>
                      <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <span class="step-title">{step.title}</span>
                      <span class="step-text">{step.text}</span>
                    </li>
                  ))}
                </ol>
              )}
              {s.note && <p class="note"><span class="meta-key">Scope</span>{s.note}</p>}
              <a class="btn btn--line ask" href={`/contact/?service=${s.slug}#enquiry`}>Ask about {s.name.toLowerCase().replace('iphone', 'iPhone').replace('meta ads', 'Meta Ads')}</a>
            </article>
          ))}
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .services-layout { display: grid; gap: 3rem; padding-bottom: var(--section); }
  @media (min-width: 60em) {
    .services-layout { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem; }
    .index { grid-column: 1 / span 3; position: sticky; top: 1.5rem; align-self: start; }
    .groups { grid-column: 5 / -1; }
  }
  .index { display: grid; gap: 1.5rem; align-content: start; }
  .index ul { margin-top: 0.4rem; }
  .index a { display: inline-block; padding-block: 0.3rem; text-decoration: none; color: var(--graphite); }
  .index a:hover { color: var(--charcoal); text-decoration: underline; }
  @media (max-width: 59.99em) {
    .index { grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); padding: 1.5rem 0; border-block: 1px solid var(--stone); }
  }

  .groups { display: grid; gap: clamp(4rem, 8vw, 7rem); }
  .group-name {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--t-statement);
    color: var(--graphite);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--charcoal);
  }
  .service {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--stone);
    scroll-margin-top: 1.5rem;
  }
  .service-name { font-size: var(--t-h3); font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; }
  .service-summary { font-family: var(--serif); font-size: 1.375rem; line-height: 1.35; }
  .service-detail { max-width: 62ch; color: var(--graphite); }

  .steps { display: grid; width: 100%; margin-top: 0.5rem; }
  .steps li {
    display: grid;
    grid-template-columns: 2.5rem 7rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.8rem;
    border-top: 1px solid color-mix(in srgb, var(--stone) 55%, transparent);
  }
  .step-num { font-size: var(--t-small); color: var(--graphite); font-variant-numeric: tabular-nums; }
  .step-title { font-weight: 700; }
  .step-text { color: var(--graphite); }
  @media (max-width: 34em) {
    .steps li { grid-template-columns: 2.5rem 1fr; }
    .step-text { grid-column: 2; }
  }

  .note { display: grid; gap: 0.35rem; max-width: 62ch; padding: 1rem 1.25rem; background: var(--soft); border-radius: 10px; font-size: var(--t-small); }
  .ask { margin-top: 0.5rem; }
</style>
