---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProcessShowcase from '../components/ProcessShowcase.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import { projects, type Photo } from '../data/work';

// Stilat's cover (the horseback shot) is the Capture still in "How we think"
// below, so this page opens on the other Stilat photograph.
const stilat = projects.find((p) => p.slug === 'stilat')!;
const stilatStill = stilat.media.find((m): m is Photo => m.kind === 'photo' && m.image !== stilat.cover)!;
const lakshi = projects.find((p) => p.slug === 'lakshi-lingaraju')!;
---

<Base
  title="Studio"
  description="Velune is a creative studio built for brands that want to be seen, remembered and talked about: visual storytelling, content, video production and digital marketing."
>
  <PageHead line1="The studio" line2="Ideas into visual presence." />

  <section class="wrap story" aria-label="About Velune">
    <div class="story-text">
      <p class="statement">Velune is a creative studio built for brands that want to be seen, remembered, and talked about.</p>
      <div class="prose lede">
        <p>
          We bring together visual storytelling, content creation, video production and digital marketing to help brands
          build a stronger presence in the digital world. From a single reel to a complete campaign, we turn ideas into
          visuals that capture attention and give brands a distinct identity.
        </p>
        <p>
          Velune works with brands, businesses, products and people, across industries and without a geographic
          restriction.
        </p>
      </div>
      <blockquote class="belief">
        <p>We believe great creative work isn't just about looking good. It's about making people stop, feel, and remember.</p>
      </blockquote>
    </div>
    <div class="story-images">
      <figure class="frame">
        <Picture src={stilatStill.image} alt={stilatStill.alt} formats={['avif', 'webp']} widths={[400, 700, 1000]} sizes="(min-width: 60em) 28vw, 50vw" loading="eager" />
      </figure>
      <figure class="frame">
        <Picture src={lakshi.cover} alt={lakshi.coverAlt} formats={['avif', 'webp']} widths={[400, 700, 1000]} sizes="(min-width: 60em) 28vw, 50vw" />
      </figure>
    </div>
  </section>

  <section class="band band--dark" aria-labelledby="process-title">
    <div class="wrap">
      <ProcessShowcase />
    </div>
  </section>

  <section class="band clients-band" aria-labelledby="clients-title">
    <div class="wrap clients-head">
      <h2 id="clients-title" class="voice">
        <span>People and brands</span>
        <span class="voice-2">Velune has worked with.</span>
      </h2>
      <a class="btn btn--dark" href="/work/">See selected work</a>
    </div>
    <ClientMarquee />
  </section>
</Base>

<style>
  .story { display: grid; gap: 3rem; padding-bottom: var(--section); }
  @media (min-width: 60em) {
    .story { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem; align-items: start; }
    .story-text { grid-column: 1 / span 6; }
    .story-images { grid-column: 8 / -1; }
  }
  .story-text { display: grid; gap: 2rem; }
  .belief {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--charcoal);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.35;
    max-width: 34ch;
  }
  .story-images { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .story-images .frame { margin: 0; aspect-ratio: 3 / 4; }
  .story-images .frame:nth-child(2) { margin-top: 4rem; }
  .story-images :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .clients-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
</style>
