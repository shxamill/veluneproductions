---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessShowcase from '../components/ProcessShowcase.astro';
import ServicePanels from '../components/ServicePanels.astro';
import Faq from '../components/Faq.astro';
import { featured, projects } from '../data/work';

const [a, b, c, d] = featured;
// The studio section shows two real projects that aren't among the four
// featured cards below, so it introduces the work without repeating it.
const portrait = projects.find((p) => p.slug === 'yash-jain')!;
const landscape = projects.find((p) => p.slug === 'nomi-kids-culture')!;
---

<Base
  description="Velune is a creative and digital studio for video production, photography, content creation, social media, branding and digital marketing."
  organization
  closing="form"
>
  <Hero />

  <section class="band band--soft" aria-labelledby="studio-title">
    <div class="wrap studio">
      <div class="studio-media">
        <a class="still still--portrait" href={`/work/${portrait.slug}/`}>
          <div class="frame">
            <Picture src={portrait.cover} alt={portrait.coverAlt} formats={['avif', 'webp']} widths={[360, 560, 800]} sizes="(min-width: 60em) 28vw, 70vw" />
          </div>
          <span class="still-caption">{portrait.client}, {portrait.category.toLowerCase()}</span>
        </a>
        <a class="still still--landscape" href={`/work/${landscape.slug}/`}>
          <div class="frame">
            <Picture src={landscape.cover} alt={landscape.coverAlt} formats={['avif', 'webp']} widths={[360, 560, 800]} sizes="(min-width: 60em) 24vw, 60vw" />
          </div>
          <span class="still-caption">{landscape.client}, {landscape.category.toLowerCase()}</span>
        </a>
      </div>
      <div class="intro">
        <h2 id="studio-title" class="section-label">The studio</h2>
        <p class="statement studio-statement">Velune is a creative studio built for brands that want to be seen, remembered, and talked about.</p>
        <p class="lede">
          We bring together visual storytelling, content creation, video production and digital marketing to help brands
          build a stronger presence in the digital world. From a single reel to a complete campaign, we turn ideas into
          visuals that capture attention and give brands a distinct identity.
        </p>
        <a class="text-link" href="/studio/">More about the studio</a>
      </div>
    </div>
  </section>

  <section class="band" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-title" class="voice">
          <span>Selected work</span>
          <span class="voice-2">for people and brands.</span>
        </h2>
        <a class="btn btn--dark" href="/work/">View all {projects.length} projects</a>
      </div>
      <div class="work-grid">
        <ProjectCard project={a} size="wide" />
        <ProjectCard project={b} size="narrow" />
        <ProjectCard project={c} size="narrow" />
        <ProjectCard project={d} size="wide" />
      </div>
    </div>
  </section>

  <section class="band band--dark" aria-labelledby="process-title">
    <div class="wrap">
      <ProcessShowcase />
    </div>
  </section>

  <section class="band" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-title" class="voice">
          <span>Nine services,</span>
          <span class="voice-2">booked alone or together.</span>
        </h2>
        <a class="btn btn--line" href="/services/">All services</a>
      </div>
      <ServicePanels />
    </div>
  </section>

  <section class="band band--soft" aria-labelledby="faq-title">
    <div class="wrap split">
      <div class="faq-side">
        <h2 id="faq-title" class="voice faq-title">
          <span>Common questions,</span>
          <span class="voice-2">answered plainly.</span>
        </h2>
      </div>
      <Faq />
    </div>
  </section>
</Base>

<style>
  /* --- The studio: real stills on the left, the studio's words on the right --- */
  .studio { display: grid; gap: clamp(3rem, 6vw, 4rem) 2rem; align-items: center; }
  .intro { display: grid; gap: 1.5rem; justify-items: start; }
  .studio-statement { font-size: clamp(1.75rem, 1.1rem + 2.2vw, 3.25rem); line-height: 1.14; max-width: 22ch; }

  .studio-media { position: relative; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .still { display: grid; gap: 0.6rem; text-decoration: none; }
  .still .frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease); }
  .still--portrait { width: 68%; }
  .still--portrait .frame { aspect-ratio: 4 / 5; }
  /* The landscape frame overlaps the portrait's lower corner, cut out by a
     band-coloured border so the two read as a laid-out spread */
  .still--landscape { position: absolute; right: 0; bottom: 0; width: 58%; }
  .still--landscape .frame { aspect-ratio: 16 / 9; outline: clamp(6px, 0.8vw, 10px) solid var(--ivory); }
  .still-caption { font-size: var(--t-small); color: var(--graphite); }
  .still--landscape .still-caption { text-align: right; }
  /* Keep the portrait's caption clear of the overlapping landscape frame */
  .still--portrait .still-caption { max-width: 58%; }
  @media (hover: hover) and (pointer: fine) {
    .still:hover .frame :global(img) { transform: scale(1.04); }
    .still:hover .still-caption { color: var(--charcoal); text-decoration: underline; text-underline-offset: 0.3em; }
  }
  .still:focus-visible { outline-offset: 6px; }

  @media (min-width: 60em) {
    .studio { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .studio-media { grid-column: 1 / span 6; }
    .intro { grid-column: 8 / -1; }
  }
  @media (max-width: 59.99em) {
    /* Words first on narrow screens, then the stills */
    .intro { order: -1; }
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .work-grid { display: grid; gap: clamp(3rem, 6vw, 5rem) 2rem; }
  @media (min-width: 60em) {
    .work-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
    .work-grid > :global(.card--wide) { grid-column: span 7; }
    .work-grid > :global(.card--narrow) { grid-column: span 5; }
    /* Stagger the narrow column down, so the grid reads as an edit, not a table */
    .work-grid > :global(:nth-child(2)) { margin-top: clamp(4rem, 10vw, 9rem); }
  }


  .faq-title { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem); }
</style>
